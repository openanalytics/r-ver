pipeline {
    parameters {
        choice(name: 'R_VERSION', choices: ['4.5.0', '4.4.3', '4.4.2', '4.4.1', '4.4.0', '4.3.3', '4.3.2', '4.3.1', '4.3.0', '4.2.3', '4.2.2', '4.2.1', '4.2.0', '4.1.3', '4.1.2', '4.1.1', '4.1.0', '4.0.5', '4.0.4', '4.0.3', '4.0.2', '4.0.1', '4.0.0', '3.6.3', '3.6.2', '3.6.1', '3.6.0', '3.5.3', '3.4.1', '3.3.3', '3.2.0'], description: 'Build r-ver image for this R version')
        booleanParam(name: 'NOCACHE', defaultValue: false, description: 'Run docker build with --no-cache')
        booleanParam(name: 'LATEST', defaultValue: true, description: 'Also tag image with the "latest" tag')
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '3'))
        ansiColor('xterm')
    }
    agent none
    stages {
        stage('Build') {
            // NB: do not run builds automatically, but only on user input
            when { 
                beforeAgent true 
                triggeredBy cause: 'UserIdCause'
            }
            environment {
                NS = 'openanalytics'
                REGISTRY = 'registry.openanalytics.eu'
                TS = sh(returnStdout: true, script: 'date -u +%Y%m%d%H%M%S').trim()
            }
            agent {
                kubernetes {
                    inheritFrom 'kaniko'
                    defaultContainer 'kaniko'
                }
            }
            steps {
                script {
                    currentBuild.displayName = "build for ${params.R_VERSION}"
                }
                sh """
                CONTEXT_PATH="${env.WORKSPACE}"
                if [ -d "${params.R_VERSION}" ]; then
                    CONTEXT_PATH="${env.WORKSPACE}/${params.R_VERSION}"
                fi
            
                /kaniko/executor \
                    -v info \
                    --context \${CONTEXT_PATH} \
                    --dockerfile \${CONTEXT_PATH}/Dockerfile \
                    --build-arg R_VERSION=${params.R_VERSION} \
                    --cache=${params.NOCACHE ? 'false' : 'true'} \
                    --cleanup \
                    --destination=${env.REGISTRY}/${env.NS}/r-ver:${params.R_VERSION} \
                    --destination=${env.REGISTRY}/${env.NS}/r-ver:${params.R_VERSION}-${env.TS} \
                    ${params.LATEST ? "--destination=${env.REGISTRY}/${env.NS}/r-ver:latest" : ""}
                """
            }
        }
    }
}
